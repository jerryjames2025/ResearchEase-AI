# ---------------------------------------------------------
# Docker Compose database credentials
# Development values only
# ---------------------------------------------------------

POSTGRES_USER=researchease
POSTGRES_PASSWORD=researchease_dev_password
POSTGRES_DB=researchease

MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=researchease_mongo_password
MONGO_INITDB_DATABASE=researchease


# ---------------------------------------------------------
# ResearchEase FastAPI settings
# ---------------------------------------------------------

RESEARCHEASE_DEBUG=true
RESEARCHEASE_MAX_UPLOAD_MB=50

RESEARCHEASE_POSTGRES_URL=postgresql+psycopg://researchease:researchease_dev_password@127.0.0.1:5432/researchease

RESEARCHEASE_MONGODB_URL=mongodb://root:researchease_mongo_password@127.0.0.1:27017/?authSource=admin
RESEARCHEASE_MONGODB_DATABASE=researchease

RESEARCHEASE_REDIS_URL=redis://127.0.0.1:6379/0

RESEARCHEASE_FAISS_DIRECTORY=data/faiss

# Use Alembic migrations rather than automatic table creation.
RESEARCHEASE_AUTO_CREATE_TABLES=false

# Leave false during development so the API can show
# a degraded storage-health response instead of crashing.
RESEARCHEASE_STRICT_STORAGE_STARTUP=false

RESEARCHEASE_SESSION_CACHE_TTL_SECONDS=3600
RESEARCHEASE_EXTERNAL_SEARCH_CACHE_TTL_SECONDS=1800

RESEARCHEASE_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

RESEARCHEASE_SEMANTIC_SCHOLAR_API_KEY=
RESEARCHEASE_CROSSREF_MAILTO=

# ---------------------------------------------------------
# Version 9: LLM providers
# ---------------------------------------------------------

# Ollama
RESEARCHEASE_OLLAMA_BASE_URL=http://127.0.0.1:11434
RESEARCHEASE_DEFAULT_OLLAMA_MODEL=qwen2.5:1.5b

# OpenAI
RESEARCHEASE_OPENAI_API_KEY=
RESEARCHEASE_DEFAULT_OPENAI_MODEL=gpt-5.4-mini

# Anthropic Claude
RESEARCHEASE_ANTHROPIC_API_KEY=
RESEARCHEASE_DEFAULT_ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini
RESEARCHEASE_GOOGLE_API_KEY=
RESEARCHEASE_DEFAULT_GOOGLE_MODEL=gemini-2.5-flash

# Hugging Face
RESEARCHEASE_HUGGINGFACE_API_TOKEN=
RESEARCHEASE_DEFAULT_HUGGINGFACE_MODEL=microsoft/Phi-3-mini-4k-instruct
RESEARCHEASE_HUGGINGFACE_MAX_NEW_TOKENS=1024

# Providers are attempted in this order after the
# selected primary provider fails.
RESEARCHEASE_LLM_FALLBACK_ORDER=ollama,google,openai,anthropic,huggingface