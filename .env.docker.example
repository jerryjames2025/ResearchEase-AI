# =========================================================
# ResearchEase AI Version 13 — Docker configuration
# =========================================================

# ---------------------------------------------------------
# PostgreSQL
# Use simple alphanumeric local passwords to avoid URL
# encoding problems in connection strings.
# ---------------------------------------------------------

POSTGRES_DB=researchease
POSTGRES_USER=researchease
POSTGRES_PASSWORD=researchease_dev_password

# ---------------------------------------------------------
# MongoDB
# ---------------------------------------------------------

MONGO_INITDB_ROOT_USERNAME=researchease
MONGO_INITDB_ROOT_PASSWORD=researchease_mongo_password

# ---------------------------------------------------------
# Redis
# ---------------------------------------------------------

REDIS_PASSWORD=researchease_redis_password

# ---------------------------------------------------------
# API
# ---------------------------------------------------------

RESEARCHEASE_API_HOST=0.0.0.0
RESEARCHEASE_API_PORT=8000
RESEARCHEASE_API_WORKERS=1
RESEARCHEASE_RUN_MIGRATIONS=true

# ---------------------------------------------------------
# Local Ollama
#
# Base compose mode connects to Ollama running on Windows.
# compose.ollama.yaml replaces this with http://ollama:11434.
# ---------------------------------------------------------

RESEARCHEASE_OLLAMA_BASE_URL=http://host.docker.internal:11434
RESEARCHEASE_DEFAULT_OLLAMA_MODEL=qwen2.5:1.5b
RESEARCHEASE_LLM_FALLBACK_ORDER=ollama

# ---------------------------------------------------------
# Optional cloud LLM providers
# ---------------------------------------------------------

RESEARCHEASE_OPENAI_API_KEY=
RESEARCHEASE_ANTHROPIC_API_KEY=
RESEARCHEASE_GOOGLE_API_KEY=
RESEARCHEASE_HUGGINGFACE_API_TOKEN=

# ---------------------------------------------------------
# Embeddings and vector databases
# ---------------------------------------------------------

RESEARCHEASE_DEFAULT_VECTOR_BACKEND=faiss
RESEARCHEASE_FAISS_DIRECTORY=/app/data/faiss

RESEARCHEASE_PINECONE_API_KEY=
RESEARCHEASE_PINECONE_INDEX_NAME=researchease-vectors
RESEARCHEASE_PINECONE_CLOUD=aws
RESEARCHEASE_PINECONE_REGION=us-east-1
RESEARCHEASE_PINECONE_METRIC=cosine

# ---------------------------------------------------------
# MLflow
# ---------------------------------------------------------

RESEARCHEASE_MLFLOW_TRACKING_URI=http://mlflow:5000
RESEARCHEASE_MLFLOW_EXPERIMENT_NAME=ResearchEase-RAG-Evaluation
RESEARCHEASE_MLFLOW_REQUEST_TIMEOUT_SECONDS=10

# This URL is opened by the user's browser.
RESEARCHEASE_MLFLOW_UI_URL=http://127.0.0.1:5000

# ---------------------------------------------------------
# LoRA fine-tuning
# ---------------------------------------------------------

RESEARCHEASE_FINE_TUNING_BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct

RESEARCHEASE_FINE_TUNING_OUTPUT_DIR=/app/artifacts/lora_adapters
RESEARCHEASE_FINE_TUNING_JOBS_DIR=/app/artifacts/fine_tuning_jobs
RESEARCHEASE_FINE_TUNING_TEMP_DIR=/app/artifacts/fine_tuning_temp

RESEARCHEASE_FINE_TUNING_MAX_EXAMPLES=500
RESEARCHEASE_FINE_TUNING_DEFAULT_MAX_SEQUENCE_LENGTH=256
RESEARCHEASE_FINE_TUNING_DEFAULT_EPOCHS=1.0
RESEARCHEASE_FINE_TUNING_DEFAULT_LEARNING_RATE=0.0002
RESEARCHEASE_FINE_TUNING_DEFAULT_LORA_R=8
RESEARCHEASE_FINE_TUNING_DEFAULT_LORA_ALPHA=16
RESEARCHEASE_FINE_TUNING_DEFAULT_LORA_DROPOUT=0.05
RESEARCHEASE_FINE_TUNING_MAX_NEW_TOKENS=128
RESEARCHEASE_FINE_TUNING_MAX_CONCURRENT_JOBS=1

# ---------------------------------------------------------
# Docker image build
# ---------------------------------------------------------

INSTALL_CUDA_TORCH=true
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu118

# ---------------------------------------------------------
# Containerized Ollama override
# ---------------------------------------------------------

OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_KEEP_ALIVE=0 