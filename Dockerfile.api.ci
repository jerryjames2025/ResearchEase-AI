FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_NO_CACHE_DIR=1

ENV APP_HOME=/app
ENV HF_HOME=/home/appuser/.cache/huggingface
ENV TOKENIZERS_PARALLELISM=false

WORKDIR ${APP_HOME}

# ---------------------------------------------------------
# System dependencies
# ---------------------------------------------------------

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        git \
        curl \
        libpq-dev \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------
# Non-root application user
# ---------------------------------------------------------

RUN groupadd --system appuser \
    && useradd \
        --system \
        --gid appuser \
        --create-home \
        --shell /bin/bash \
        appuser

# ---------------------------------------------------------
# Generate CPU-safe dependency list
# ---------------------------------------------------------

COPY requirements.txt /tmp/requirements.txt
COPY scripts/create_ci_requirements.py /tmp/create_ci_requirements.py

RUN python /tmp/create_ci_requirements.py \
        --source /tmp/requirements.txt \
        --output /tmp/requirements.ci.txt

# ---------------------------------------------------------
# Install Python dependencies
# ---------------------------------------------------------

RUN python -m pip install --upgrade \
        pip \
        setuptools \
        wheel

# Install CPU-only PyTorch.
RUN python -m pip install \
        torch==2.7.1 \
        --index-url https://download.pytorch.org/whl/cpu

RUN python -m pip install \
        -r /tmp/requirements.ci.txt

# Confirm that CI is not using a CUDA build.
RUN python -c "import torch; print('Torch:', torch.__version__); print('CUDA build:', torch.version.cuda); print('CUDA available:', torch.cuda.is_available())"

# ---------------------------------------------------------
# Copy project
# ---------------------------------------------------------

COPY --chown=appuser:appuser . ${APP_HOME}

RUN mkdir -p \
        /app/data/faiss \
        /app/artifacts/lora_adapters \
        /app/artifacts/fine_tuning_jobs \
        /app/artifacts/fine_tuning_temp \
        /home/appuser/.cache/huggingface \
    && chown -R appuser:appuser \
        /app/data \
        /app/artifacts \
        /home/appuser/.cache

USER appuser

EXPOSE 8000

CMD ["python", "docker/api_entrypoint.py"]